  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "hooks": {"SessionStart":[{"matcher":"^(startup|resume|clear|compact|fork)$","hooks":[{"type":"command","command":"bash '/Users/jeffrey/.claude/hooks/herdr-agent-state.sh' session","timeout":10}]}]}
